# --- Azure AI Search ---
SEARCH_ENDPOINT=https://<your-search-resource>.search.windows.net
AI_SEARCH_KNOWLEDGE_SOURCE_NAME="ai-search-knowledge-source"
KNOWLEDGE_BASE_NAME="app-knowledge-base"

# --- Microsoft Fabric (OneLake source) ---
# GUIDs taken from the lakehouse URL:
# https://<host>/groups/<FABRIC_WORKSPACE_ID>/lakehouses/<FABRIC_LAKEHOUSE_ID>
# The search service's system-assigned managed identity must hold at least
# Contributor on the Fabric workspace (use `search_system_identity_principal_id`
# from the Terraform outputs).
FABRIC_WORKSPACE_ID=<your-fabric-workspace-guid>
FABRIC_LAKEHOUSE_ID=<your-lakehouse-guid>

# --- Embeddings (Foundry / Azure OpenAI) ---
AOAI_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
EMBEDDING_DEPLOYMENT="text-embedding-3-large"
EMBEDDING_DIMENSIONS=3072

# --- Foundry IQ knowledge base ---
FOUNDRY_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com
CHAT_MODEL_DEPLOYMENT="gpt-4.1-mini"

# Incremental indexing by default (only new/changed lakehouse files are
# ingested). Set to true to reset the indexer and reprocess every file.
RESET_INDEXER=false
