# --- Foundry project --------------------------------------------------------
# terraform output -raw project_endpoint
FOUNDRY_PROJECT_ENDPOINT=https://<account>.ai.azure.com/api/projects/<project>
FOUNDRY_MODEL_DEPLOYMENT_NAME=gpt-4.1-mini

# --- Fabric connection ------------------------------------------------------
# Name of the project connection to the Fabric data agent.
FABRIC_CONNECTION_NAME=my-fabric-connection

# --- Only needed by create_connection.sh ------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=
FOUNDRY_ACCOUNT_NAME=
FOUNDRY_PROJECT_NAME=
# Both GUIDs come from the data agent URL:
# https://app.fabric.microsoft.com/groups/<workspace_id>/aiskills/<artifact_id>/
FABRIC_WORKSPACE_ID=
FABRIC_DATA_AGENT_ID=

# --- Optional ---------------------------------------------------------------
AGENT_NAME=demo-fabric-agent
# KEEP_AGENT=true
# AGENT_INSTRUCTIONS=
